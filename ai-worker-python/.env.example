# ==============================================================================
# DocuMind AI Worker Configuration (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành '.env' trong cùng thư mục: cp .env.example .env
# 2. Điền các khóa bảo mật của riêng bạn vào bên dưới.
# 3. Tệp '.env' đã được thêm vào .gitignore và SẼ KHÔNG BAO GIỜ bị đẩy lên GitHub.
# ==============================================================================

# Thông tin ứng dụng
APP_NAME="OCR RAG AI Worker"
DEBUG=True

# Google Gemini API Key (Tùy chọn: để trống nếu muốn chạy mô hình tổng hợp Offline)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mô hình LLM & Cấu hình RAG
GEMINI_MODEL_NAME=gemini-1.5-flash
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
EMBEDDING_PROVIDER=lightweight
